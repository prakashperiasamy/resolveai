{
  "name": "resolveai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An escalation decision-support prototype linking customer impact, engineering evidence, case ownership, blockers, and QA/release workflows.",
  "author": "Prakash Periasamy",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx scripts/verify-escalations.ts && node --import tsx scripts/verify-render.tsx && node scripts/check-artifacts.mjs",
    "fixtures": "node --import tsx scripts/export-fixtures.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "tsx": "^4.20.5"
  }
}
